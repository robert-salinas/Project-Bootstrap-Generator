<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project_name }} - RS Design System</title>
    <!-- RS Design System CSS (Simulado o Link Real) -->
    <link rel="stylesheet" href="assets/css/rs-design-system.css">
    <link rel="stylesheet" href="assets/css/style.css">
</head>
<body class="rs-dark-secondary">
    <header class="rs-header">
        <div class="container">
            <h1 class="rs-text-white">{{ project_name }}</h1>
            <p class="rs-text-light">Created by {{ author_name }}</p>
        </div>
    </header>

    <nav class="rs-navbar">
        <div class="container">
            <!-- Navigation items here -->
        </div>
    </nav>

    <main class="container rs-mt-5">
        <div class="rs-card">
            <h2 class="rs-text-orange">Bienvenido a {{ project_name }}</h2>
            <p class="rs-text-light">Proyecto frontend inicializado con RS Design System.</p>
            <button class="rs-btn-primary">Empezar</button>
        </div>
    </main>

    <footer class="rs-footer rs-mt-5">
        <div class="container rs-text-center">
            <p class="rs-text-muted">Powered by RS Digital</p>
        </div>
    </footer>

    <script src="assets/js/app.js"></script>
</body>
</html>

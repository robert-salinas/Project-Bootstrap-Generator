{% if 'python' in project_type or 'fastapi' in project_type or 'data' in project_type %}
FROM python:3.9-slim

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -r requirements.txt || echo "No requirements.txt found"

CMD ["python", "src/main.py"]
{% elif 'node' in project_type or 'web' in project_type %}
FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 3000
CMD ["npm", "start"]
{% else %}
FROM alpine:latest
WORKDIR /app
COPY . .
CMD ["sh"]
{% endif %}
